# Desarrollo local rapido con SQLite.
# DATABASE_URL=sqlite:///./data/smartcontable.db

# Beta $0 con TiDB Cloud Serverless Free (MySQL compatible).
# Reemplaza usuario, password, host, puerto y base con los datos de TiDB.
DATABASE_URL=mysql+pymysql://usuario:password@host:4000/smart_contable?ssl_verify_cert=true

SECRET_KEY=change-this-to-a-random-string-of-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

ENVIRONMENT=development
DEBUG=false

# Agrega aqui el dominio real del piloto en Vercel una vez aprovisionado.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Limites iniciales para proteger hosting gratuito durante la beta.
MAX_XML_UPLOAD_BYTES=2097152
MAX_ZIP_UPLOAD_BYTES=26214400
MAX_XML_FILES_PER_ZIP=1000
MAX_PDF_UPLOAD_BYTES=10485760
