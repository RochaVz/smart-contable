# ===== DATABASE =====
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/smart_contable
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# ===== SECURITY =====
# Generar SECRET_KEY con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Mínimo 32 caracteres
SECRET_KEY=tu_secret_key_aqui_cambiar_en_produccion_minimo_32_caracteres

# ===== ENVIRONMENT =====
ENVIRONMENT=development
DEBUG=False

# ===== REDIS =====
REDIS_URL=redis://localhost:6379/0

# ===== LOGGING =====
LOG_LEVEL=INFO

# ===== CORS =====
ALLOWED_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
